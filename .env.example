# --- Models (leave OPENAI_API_KEY empty to run the offline demo mode) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=            # optional fallback provider

# --- LangSmith tracing ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ahtama

# --- App ---
SECRET_KEY=change-me-in-production
# DATABASE_URL=postgresql+psycopg://user:pass@host/ahtama   # defaults to SQLite in ./data
